{
  "name": "oakhurst-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "esbuild src/pairing.ts src/install-detect.ts --format=esm --outdir=dist-test --out-extension:.js=.mjs --log-level=error && node --test test/pairing.test.mjs test/install.test.mjs; s=$?; rm -rf dist-test; exit $s",
    "prebuild": "node -e \"const f=require('fs');f.mkdirSync('public/emojibase/en',{recursive:true});for(const n of ['data','messages'])f.copyFileSync('node_modules/emojibase-data/en/'+n+'.json','public/emojibase/en/'+n+'.json')\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/qrcode": "^1.5.6",
    "aws-amplify": "^6.22.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "frimousse": "^0.4.0",
    "input-otp": "^1.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "emojibase-data": "^16.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
